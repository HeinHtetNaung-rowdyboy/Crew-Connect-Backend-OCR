OCR_BACKEND=local
OCR_ENGINE=paddleocr
OCR_FALLBACK=tesseract
# Cascade: cheapest first; later engines run only if the validity gate fails.
# Leave empty to use OCR_ENGINE/OCR_FALLBACK as before.
OCR_CASCADE=tesseract,paddleocr
TESSERACT_ZOOM=2.0
PADDLE_ZOOM=1.5
PADDLE_DET_SIDE=960
PADDLE_CPU_THREADS=0
# Empty model names = PaddleOCR default (slower, more accurate, better for Korean)
PADDLE_DET_MODEL=PP-OCRv5_mobile_det
PADDLE_REC_MODEL=PP-OCRv5_mobile_rec
PADDLEOCR_LANG=en
OCR_MIN_TEXT=100
TESSERACT_LANG=eng
MAX_UPLOAD_MB=20
MAX_PAGES=30
CLASSIFICATION_THRESHOLD=0.55
USE_OLLAMA=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=240
VISION_ZOOM=1.45
VISION_MAX_PAGES=1
USE_LLM_CLASSIFIER=true
USE_AI_REVIEWER=false
FASTAPI_URL=http://127.0.0.1:8000
# optional cloud API
VISION_AGENT_API_KEY=
LANDINGAI_EXTRACT=false
