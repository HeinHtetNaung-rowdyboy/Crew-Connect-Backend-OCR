OCR_BACKEND=local
OCR_ENGINE=paddleocr
OCR_FALLBACK=tesseract
PADDLEOCR_LANG=en
OCR_MIN_TEXT=100
TESSERACT_LANG=eng
MAX_UPLOAD_MB=20
MAX_PAGES=30
CLASSIFICATION_THRESHOLD=0.55
USE_OLLAMA=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=240
VISION_MAX_PAGES=4
USE_LLM_CLASSIFIER=true
USE_AI_REVIEWER=true
FASTAPI_URL=http://127.0.0.1:8000
# optional cloud API
VISION_AGENT_API_KEY=
LANDINGAI_EXTRACT=false
